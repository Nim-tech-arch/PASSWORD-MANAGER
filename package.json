{
  "name": "secure-password-manager",
  "version": "0.1.0",
  "description": "A secure password manager with CLI and GUI interfaces",
  "scripts": {
    "build": "tsc",
    "build:react": "webpack --mode production",
    "build:all": "npm run build && npm run build:react",
    "dev": "ts-node src/cli/index.ts",
    "cli": "node dist/cli/index.js",
    "gui": "electron .",
    "gui:dev": "concurrently \"webpack serve --mode development\" \"wait-on http://localhost:8080 && electron .\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rimraf dist build"
  },
  "dependencies": {
    "crypto": "^1.0.1",
    "sqlite3": "^5.1.6",
    "sqlite": "^5.0.1",
    "bcryptjs": "^2.4.3",
    "commander": "^11.0.0",
    "chalk": "^5.3.0",
    "inquirer": "^8.2.5",
    "electron": "^25.0.0",
    "electron-is-dev": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "axios": "^1.4.0",
    "react-router-dom": "^6.14.0",
    "uuid": "^9.0.0",
    "speakeasy": "^2.0.0",
    "qrcode.react": "^1.0.1",
    "crypto-js": "^4.1.1",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0",
    "ts-loader": "^9.4.0",
    "html-webpack-plugin": "^5.5.0",
    "concurrently": "^8.2.0",
    "wait-on": "^7.0.1",
    "rimraf": "^5.0.0",
    "electron-builder": "^24.6.0",
    "@types/uuid": "^9.0.0",
    "@types/speakeasy": "^2.0.0",
    "@types/express": "^4.17.19",
    "@types/jsonwebtoken": "^9.0.2"
  },
  "homepage": "./",
  "build": {
    "appId": "com.passwordmanager.app",
    "productName": "Password Manager",
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    }
  }
}

